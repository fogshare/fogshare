[Unit]
Description=Fogshare Self-Hosted Ephemeral File-Sharing Engine
Documentation=https://github.com/fogshare/fogshare
After=network.target

[Service]
Type=simple
User=fogshare
Group=fogshare
WorkingDirectory=/opt/fogshare

# -----------------------------------------------------------------------------
# Runtime Environment & Perl Dependency Path Configuration
# -----------------------------------------------------------------------------
Environment="MOJO_MODE=production"
Environment="MOJO_REVERSE_PROXY=1"
Environment="APP_DATA_DIR=/opt/fogshare/data"
Environment="APP_CONFIG=/opt/fogshare/data/fogshare.json"
Environment="APP_PASSWD_FILE=/opt/fogshare/data/passwd.json"

# Option A: If dependencies are installed into project tree via local::lib:
# Environment="PERL5LIB=/opt/fogshare/local/lib/perl5"
# Environment="PATH=/opt/fogshare/local/bin:/usr/local/bin:/usr/bin:/bin"

# Option B: If using perlbrew or plenv, specify the interpreter binary directly:
# ExecStart=/home/fogshare/perl5/perlbrew/perls/perl-5.38.0/bin/starman --workers 4 --port 3647 /opt/fogshare/fogshared

# Option C: Default system-wide Perl installation:
ExecStart=/usr/bin/env starman --workers 4 --port 3647 /opt/fogshare/fogshared
ExecReload=/bin/kill -HUP $MAINPID

# -----------------------------------------------------------------------------
# Reliability & Limits
# -----------------------------------------------------------------------------
Restart=always
RestartSec=5
LimitNOFILE=65535

# -----------------------------------------------------------------------------
# System Logging
# -----------------------------------------------------------------------------
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fogshare

[Install]
WantedBy=multi-user.target