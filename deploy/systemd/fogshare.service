#
# Fogshare - Systemd Service Unit (Standalone Default)
#

[Unit]
Description=Fogshare Self-Hosted Ephemeral File-Sharing Engine
Documentation=https://github.com/fogshare/fogshare
After=network.target

[Service]
Type=simple
User=fogshare
Group=fogshare
WorkingDirectory=/opt/fogshare

# Load local environment overrides if present
EnvironmentFile=-/opt/fogshare/.env

# Default baseline environment variables
Environment="MOJO_MODE=production"
Environment="MOJO_REVERSE_PROXY=1"
Environment="APP_DATA_DIR=/opt/fogshare/data"
Environment="APP_CONFIG=/opt/fogshare/data/fogshare.json"
Environment="APP_PASSWD_FILE=/opt/fogshare/data/passwd.json"

ExecStart=/usr/bin/env starman --workers 4 --port 3647 /opt/fogshare/fogshared
ExecReload=/bin/kill -HUP $MAINPID

Restart=always
RestartSec=5
LimitNOFILE=65535

StandardOutput=journal
StandardError=journal
SyslogIdentifier=fogshare

[Install]
WantedBy=multi-user.target