#
# Fogshare - Ingress Nginx Virtual Host Template
#

server {
    listen ${HTTP_PORT};
    server_name ${ADMIN_DOMAIN} ${SHARE_DOMAIN} *.${SHARE_DOMAIN};

    client_max_body_size ${MAX_UPLOAD_MB}M;

    # 1. UI static assets bypass
    location ~ ^/(favicon\.ico|logo\.svg)$ {
        root ${APP_DIR}/public;
        expires 30d;
        add_header Cache-Control "public, no-transform";
        add_header X-Content-Type-Options "nosniff" always;
        access_log off;
    }

    # 2. X-Accel-Redirect internal delivery
    location ~ ^/_internal_files/(.*)$ {
        internal;
        alias ${DATA_DIR}/files/$1;
        sendfile on;
        tcp_nopush on;
        tcp_nodelay on;
        max_ranges 0;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location ~ ^/_internal_libs/(.*)$ {
        internal;
        alias ${DATA_DIR}/libs/$1;
        sendfile on;
        tcp_nopush on;
        tcp_nodelay on;
        max_ranges 0;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Deny hidden files
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    # 3. Dynamic backend proxy
    location / {
        proxy_pass http://127.0.0.1:${BACKEND_PORT};

        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Accel-Support "1";

        # HTTP/1.1 keepalive without WebSocket dependencies
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_request_buffering off;

        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }
}